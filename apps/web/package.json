    "verify:jarvis-redteam": "node verify-jarvis-redteam.mjs",
    "preview": "vite preview --config vite.config.mjs --configLoader native --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@tradevision/contracts": "file:../../packages/contracts",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "typescript": "^5.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2"
  }

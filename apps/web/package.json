{
  "name": "@tradevision/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs --configLoader native --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config vite.config.mjs --configLoader native",
    "typecheck": "tsc -p tsconfig.json --noEmit",

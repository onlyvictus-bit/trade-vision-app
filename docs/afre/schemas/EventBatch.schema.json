{
  "$defs": {
    "Bar": {
      "additionalProperties": false,
      "properties": {
        "available_ns": {
          "minimum": 0,
          "title": "Available Ns",
          "type": "integer"
        },
        "close": {
          "exclusiveMinimum": 0,
          "title": "Close",
          "type": "number"
        },
        "close_ns": {
          "minimum": 0,
          "title": "Close Ns",
          "type": "integer"
        },
        "high": {
          "exclusiveMinimum": 0,
          "title": "High",
          "type": "number"
        },
        "low": {
          "exclusiveMinimum": 0,
          "title": "Low",
          "type": "number"
        },
        "minutes": {
          "enum": [
            1,
            3,
            5,
            15,
            30,
            60
          ],
          "title": "Minutes",
          "type": "integer"
        },
        "open": {
          "exclusiveMinimum": 0,
          "title": "Open",
          "type": "number"
        },
        "open_ns": {
          "minimum": 0,
          "title": "Open Ns",
          "type": "integer"
        },
        "price_basis": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Price Basis",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "symbol": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Symbol",
          "type": "string"
        },
        "volume": {
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        }
      },
      "required": [
        "symbol",
        "minutes",
        "open_ns",
        "close_ns",
        "available_ns",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "source_id",
        "price_basis"
      ],
      "title": "Bar",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "available_ns": {
          "minimum": 0,
          "title": "Available Ns",
          "type": "integer"
        },
        "blocks_new_entry": {
          "default": false,
          "title": "Blocks New Entry",
          "type": "boolean"
        },
        "evidence_hash": {
          "minLength": 16,
          "title": "Evidence Hash",
          "type": "string"
        },
        "expires_ns": {
          "exclusiveMinimum": 0,
          "title": "Expires Ns",
          "type": "integer"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "default": "",
          "maxLength": 300,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "VALID",
            "BLOCKED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "available_ns",
        "expires_ns",
        "status",
        "evidence_hash"
      ],
      "title": "Capability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_ns": {
      "exclusiveMinimum": 0,
      "title": "Available Ns",
      "type": "integer"
    },
    "capabilities": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Capability"
        },
        "type": "array"
      },
      "title": "Capabilities",
      "type": "object"
    },
    "event_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:@/-]+$",
      "title": "Event Id",
      "type": "string"
    },
    "execution_bars": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Bar"
      },
      "maxItems": 500,
      "title": "Execution Bars",
      "type": "array"
    },
    "feature_bars": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Bar"
      },
      "maxItems": 100,
      "title": "Feature Bars",
      "type": "array"
    },
    "integrity_faults": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Integrity Faults",
      "type": "array"
    }
  },
  "required": [
    "event_id",
    "available_ns"
  ],
  "title": "EventBatch",
  "type": "object"
}

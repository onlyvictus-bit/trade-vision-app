{
  "$defs": {
    "Costs": {
      "additionalProperties": false,
      "properties": {
        "fee_bps_per_side": {
          "default": 1.0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Fee Bps Per Side",
          "type": "number"
        },
        "impact_bps": {
          "default": 0.5,
          "maximum": 1000,
          "minimum": 0,
          "title": "Impact Bps",
          "type": "number"
        },
        "slippage_bps": {
          "default": 1.0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Slippage Bps",
          "type": "number"
        },
        "spread_bps": {
          "default": 1.0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Spread Bps",
          "type": "number"
        },
        "version": {
          "default": "costs-assumed-1",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:@/-]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "Costs",
      "type": "object"
    },
    "Side": {
      "enum": [
        "LONG",
        "SHORT"
      ],
      "title": "Side",
      "type": "string"
    },
    "Template": {
      "enum": [
        "FIRST_BREAK",
        "ACCEPTANCE",
        "RETEST_HOLD",
        "GAP_FADE",
        "RECLAIM",
        "PD_LEVEL_BREAK"
      ],
      "title": "Template",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cost_model": {
      "$ref": "#/$defs/Costs"
    },
    "created_ns": {
      "title": "Created Ns",
      "type": "integer"
    },
    "execution_minutes": {
      "enum": [
        1,
        3,
        5
      ],
      "title": "Execution Minutes",
      "type": "integer"
    },
    "expires_ns": {
      "title": "Expires Ns",
      "type": "integer"
    },
    "flat_ns": {
      "title": "Flat Ns",
      "type": "integer"
    },
    "invalidate_on": {
      "enum": [
        "CLOSE_BACK_INSIDE",
        "GAP_DIRECTION_RECLAIM"
      ],
      "title": "Invalidate On",
      "type": "string"
    },
    "invalidation_level": {
      "exclusiveMinimum": 0,
      "title": "Invalidation Level",
      "type": "number"
    },
    "last_entry_ns": {
      "title": "Last Entry Ns",
      "type": "integer"
    },
    "live_trading_blocked": {
      "const": true,
      "default": true,
      "title": "Live Trading Blocked",
      "type": "boolean"
    },
    "maximum_entry": {
      "exclusiveMinimum": 0,
      "title": "Maximum Entry",
      "type": "number"
    },
    "maximum_notional": {
      "exclusiveMinimum": 0,
      "title": "Maximum Notional",
      "type": "number"
    },
    "maximum_quantity": {
      "exclusiveMinimum": 0,
      "title": "Maximum Quantity",
      "type": "integer"
    },
    "minimum_entry": {
      "exclusiveMinimum": 0,
      "title": "Minimum Entry",
      "type": "number"
    },
    "order_routing_enabled": {
      "const": false,
      "default": false,
      "title": "Order Routing Enabled",
      "type": "boolean"
    },
    "pdc": {
      "exclusiveMinimum": 0,
      "title": "Pdc",
      "type": "number"
    },
    "policy_hash": {
      "title": "Policy Hash",
      "type": "string"
    },
    "price_basis": {
      "title": "Price Basis",
      "type": "string"
    },
    "proposal_id": {
      "title": "Proposal Id",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "reference_entry": {
      "exclusiveMinimum": 0,
      "title": "Reference Entry",
      "type": "number"
    },
    "reference_target": {
      "exclusiveMinimum": 0,
      "title": "Reference Target",
      "type": "number"
    },
    "requires_gap_unfilled": {
      "title": "Requires Gap Unfilled",
      "type": "boolean"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "reward_risk": {
      "enum": [
        1,
        2
      ],
      "title": "Reward Risk",
      "type": "integer"
    },
    "risk_budget": {
      "exclusiveMinimum": 0,
      "title": "Risk Budget",
      "type": "number"
    },
    "session_date": {
      "title": "Session Date",
      "type": "string"
    },
    "side": {
      "$ref": "#/$defs/Side"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "stop": {
      "exclusiveMinimum": 0,
      "title": "Stop",
      "type": "number"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "template": {
      "$ref": "#/$defs/Template"
    },
    "tick_size": {
      "exclusiveMinimum": 0,
      "title": "Tick Size",
      "type": "number"
    },
    "trade_allowed": {
      "const": false,
      "default": false,
      "title": "Trade Allowed",
      "type": "boolean"
    }
  },
  "required": [
    "proposal_id",
    "policy_hash",
    "snapshot_hash",
    "symbol",
    "session_date",
    "template",
    "side",
    "created_ns",
    "expires_ns",
    "last_entry_ns",
    "flat_ns",
    "execution_minutes",
    "tick_size",
    "price_basis",
    "reference_entry",
    "minimum_entry",
    "maximum_entry",
    "stop",
    "reward_risk",
    "reference_target",
    "maximum_quantity",
    "risk_budget",
    "maximum_notional",
    "cost_model",
    "pdc",
    "requires_gap_unfilled",
    "invalidation_level",
    "invalidate_on",
    "reason_codes"
  ],
  "title": "TradePlan",
  "type": "object"
}
